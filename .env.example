MARIADB_IMAGE=mariadb:12.3
MARIADB_CONTAINER_NAME=moodle-db
MARIADB_ROOT_PASSWORD=change-this-root-password
MARIADB_CHARACTER_SET=utf8mb4
MARIADB_COLLATE=utf8mb4_unicode_ci
MARIADB_DATA_PATH=./data/mariadb

MOODLE_IMAGE=local/moodle:5.2
MOODLE_CONTAINER_NAME=moodle
MOODLE_BRANCH=MOODLE_502_STABLE
MOODLE_HTTP_PORT=8080
MOODLE_WWWROOT=http://localhost:8080
MOODLE_DATABASE_HOST=mariadb
MOODLE_DATABASE_USER=moodle
MOODLE_DATABASE_PASSWORD=change-this-database-password
MOODLE_DATABASE_NAME=moodle
MOODLE_USERNAME=admin
MOODLE_PASSWORD=change-this-admin-password
MOODLE_EMAIL=admin@example.com
MOODLE_SITE_NAME=Moodle
MOODLE_DATA_PATH=./data/moodledata